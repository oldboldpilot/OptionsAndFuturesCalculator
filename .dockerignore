# Build context is the repository root (railway.json points at
# backend/Dockerfile, which leaves the context here). Keep the context to what
# the image actually needs: the backend tree, minus its build output and the
# large non-build subtrees vendored inside SGEE and sensen.

.git
*.log

frontend
node_modules
**/node_modules

backend/build
.next
out

docs
.playwright-mcp
.claude
config

backend/external/SGEE/web-lsp
backend/external/SGEE/vscode-extension
backend/BigBrotherAnalytics
backend/sensen/external/CosyVoice
backend/sensen/eval_samples
backend/sensen/demo_qwen3

# Kept in step with .railwayignore. backend/CMakeLists.txt:139-146 FORCEs
# BUILD_PYTHON_BINDINGS, BUILD_TESTS, BUILD_EXAMPLES and BUILD_BENCHMARKS off,
# and sensen guards add_subdirectory on exactly those options, so none of these
# is read during configure. Verified by parking all four and re-configuring.
backend/sensen/benchmarks
backend/sensen/tests
backend/sensen/python
backend/sensen/examples
backend/sensen/docs
**/*.nsys-rep
**/*.sqlite
**/perf.data*
**/core.*
