# Environment & Secrets
.env
.env.*
!.env.example
config/.env
config/config.yaml

# Build artifacts & Binaries
build/
build-*/
*.so
*.pcm
*.a
*.o
*.out

# System & Logs
*.log
.DS_Store
frontend/node_modules/
frontend/.next/
.playwright-mcp/
current-ui.png

# Worker dependencies and local wrangler state
workers/*/node_modules/
workers/*/.wrangler/
# The root .wrangler/ too. It was tracked, which put the Cloudflare account id
# and name into the history as build cache -- not a credential, but machine
# state that differs per developer and conflicts on every deploy.
.wrangler/

# Python bytecode
__pycache__/
*.py[cod]

# calculator.assistant.StrategyAssistant's fine-tuned Qwen3-0.6B GGUF
# (Q8_0, ~639 MB). It is fetched during the Docker build from MODEL_URL and
# verified against MODEL_SHA256 (backend/Dockerfile's `model` stage) -- it is
# never a repository artifact. A binary this size in git history is not
# something a later commit can undo cheaply: every clone, and every future
# clone, pays for it forever, unlike an ignored file that a stray local copy
# never touches.
**/*.gguf
