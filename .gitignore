# Environment & Secrets
.env
.env.*
!.env.example
config/.env
config/config.yaml

# Build artifacts & Binaries
build/
build-*/
*.so
*.pcm
*.a
*.o
*.out

# System & Logs
*.log
.DS_Store
frontend/node_modules/
frontend/.next/
.playwright-mcp/
current-ui.png

# Worker dependencies and local wrangler state
workers/*/node_modules/
workers/*/.wrangler/
# The root .wrangler/ too. It was tracked, which put the Cloudflare account id
# and name into the history as build cache -- not a credential, but machine
# state that differs per developer and conflicts on every deploy.
.wrangler/

# Python bytecode
__pycache__/
*.py[cod]

# calculator.assistant.StrategyAssistant's fine-tuned Qwen3-0.6B GGUF
# (Q8_0, ~639 MB). It is fetched during the Docker build from MODEL_URL and
# verified against MODEL_SHA256 (backend/Dockerfile's `model` stage) -- it is
# never a repository artifact. A binary this size in git history is not
# something a later commit can undo cheaply: every clone, and every future
# clone, pays for it forever, unlike an ignored file that a stray local copy
# never touches.
**/*.gguf

# Merged bf16 checkpoints. `**/*.gguf` already keeps quantised artefacts out;
# these are the 16-bit safetensors a merge produces, ~1.2 GB each, and they are
# the INPUT to a conversion rather than anything a reader of this repository
# needs. They live here so a bit-width measurement can name the exact bytes it
# used -- the provenance belongs in the evidence directory, not in git objects.
model-archive/

# Scratch output of agent/dataset/build_dataset.py. The CANONICAL training set is
# agent/dataset/data/ -- that is what train.py consumes (--data ../dataset/data).
# Keeping both tracked invites measuring the wrong one: out/ held 11,400 rows while
# the model trained on data/'s 28,500, and dataset statistics were once reported
# from out/ for a run that never read it.
agent/dataset/out/

# Cloudflare Worker local secrets (wrangler dev). Never committable.
.dev.vars
**/.dev.vars

# Generated training datasets, never repository content. The mortgage ones came from a generator that
# is no longer in this tree; where it went is stated once, in CLAUDE.md under "Mortgage assistant".
#
# The GLOB matters. This was `agent/dataset/data_mortgage/` -- the exact
# directory, trailing slash -- and every PRESERVED SNAPSHOT beside it was
# therefore tracked. Those snapshots are the whole working method of a retrain:
# `data_mortgage.pre-rentalcashflow-20260916T000150Z/` exists so
# `--assert-disjoint-from` can prove a holdout was not in the previous model's
# train split, and one gets created every time the corpus changes. 12,000 rows
# and 11 MB each, all regenerable from the generator at that commit.
#
# Caught by `git add -A agent` sweeping one into a commit about something else.
agent/dataset/data_mortgage/
agent/dataset/data_mortgage.*/
# Retrained corpora kept beside the canonical one while a model is being compared (37 MB, not
# repository content). They were generated by `build_mortgage_dataset.py`; see CLAUDE.md, "Mortgage assistant".
agent/dataset/data_mortgage_v*/

# Issued API keys in plaintext. Never committed; hand to the customer and delete.
config/keys/

# CTest's per-run scratch directory. Generated wherever ctest is invoked, so it
# appears at the repo root whenever anyone runs the suite from here. Never an
# input to any build, and untracked build output at the ROOT is exactly what
# rides along in `railway up`, which uploads the working tree rather than git.
Testing/

# Google OAuth client (Search Console API) and the token it mints. Secrets:
# never committed. The NAS backup is the only copy outside this machine.
config/client_secret_*.json
config/google_search_console_token.json

# Valgrind core dumps. `config/cpp_details.txt` rule 36 makes valgrind part of
# the workflow, so these WILL recur; a 26 MB untracked core from
# replicated_broker_tests is what prompted this line.
vgcore.*
