# Environment & Secrets
.env
.env.*
!.env.example
config/.env
config/config.yaml

# Build artifacts & Binaries
build/
build-*/
*.so
*.pcm
*.a
*.o
*.out

# System & Logs
*.log
.DS_Store
frontend/node_modules/
frontend/.next/
.playwright-mcp/
current-ui.png

# Worker dependencies and local wrangler state
workers/*/node_modules/
workers/*/.wrangler/
# The root .wrangler/ too. It was tracked, which put the Cloudflare account id
# and name into the history as build cache -- not a credential, but machine
# state that differs per developer and conflicts on every deploy.
.wrangler/

# Python bytecode
__pycache__/
*.py[cod]

# calculator.assistant.StrategyAssistant's fine-tuned Qwen3-0.6B GGUF
# (Q8_0, ~639 MB). It is fetched during the Docker build from MODEL_URL and
# verified against MODEL_SHA256 (backend/Dockerfile's `model` stage) -- it is
# never a repository artifact. A binary this size in git history is not
# something a later commit can undo cheaply: every clone, and every future
# clone, pays for it forever, unlike an ignored file that a stray local copy
# never touches.
**/*.gguf

# Scratch output of agent/dataset/build_dataset.py. The CANONICAL training set is
# agent/dataset/data/ -- that is what train.py consumes (--data ../dataset/data).
# Keeping both tracked invites measuring the wrong one: out/ held 11,400 rows while
# the model trained on data/'s 28,500, and dataset statistics were once reported
# from out/ for a run that never read it.
agent/dataset/out/

# Cloudflare Worker local secrets (wrangler dev). Never committable.
.dev.vars
**/.dev.vars

# Generated training datasets (regenerate deterministically with --seed)
agent/dataset/data_mortgage/

# Issued API keys in plaintext. Never committed; hand to the customer and delete.
config/keys/
